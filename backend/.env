# =============================================================================
# AayuCare Backend Configuration
# Production-Grade Healthcare Application
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Atlas (Document Database)
# Purpose: Medical records, prescriptions, notifications, events, Better Auth
# Required collections: 11 (users, appointments, prescriptions, medicalrecords, 
#                          notifications, events, healthmetrics, schedules,
#                          session, account, verification)
# Database: aayucare (NOT test)
# CRITICAL: Must include database name in URI and retryWrites parameter
MONGODB_URI=mongodb+srv://keval:Keval123@cluster0.krz8pth.mongodb.net/aayucare?retryWrites=true&w=majority

# PostgreSQL (Primary Relational Database)
# Purpose: ACID transactions, user profiles, appointments, payments
# Required tables: 5 (users, doctors, patients, appointments, payments)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aayucare_admin
POSTGRES_PASSWORD=aayucare123
POSTGRES_DB=aayucare_db
POSTGRES_MAX_POOL=20
POSTGRES_MIN_POOL=5

# Redis (Caching + Session Management)
# Purpose: API response caching, session storage, OTP, rate limiting
# TTL: 10s-300s depending on data type
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# Better Auth Secret (32+ characters, cryptographically secure)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=a7f3c9d2e8b1f6a4c3d7e9f2b5a8c1d4e7f9a2b5c8d1e4f7a9b2c5d8e1f4a7b9c

# JWT Configuration (64+ characters for production)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=193ac068fa273d3d1b32c3365c97a629ed8b84cda912733ac38c4cfbdcfe4d95
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=fd3e4402dbcf3b401a4332cce874979f1eaf0afc885d016dc6ed64348c82033742ee475c203a078a7a7d209885efb47812559ee200299628cad544ee87e18d22
JWT_REFRESH_EXPIRE=7d

# Twilio Configuration (SMS & Notifications)
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# App Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Email Configuration (Optional - for password reset & notifications)
# For production, use services like SendGrid, AWS SES, or Mailgun
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@aayucare.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100