# ==========================================
# AayuCare Backend - Environment Variables
# ==========================================

# --- Core Server Configuration ---
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:19006

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aayucare

# --- Security & Authentication ---  [ node -e "console.log('\nJWT_SECRET=' + require('crypto').randomBytes(48).toString('hex')); console.log('BETTER_AUTH_SECRET=' + require('crypto').randomBytes(32).toString('hex') + '\n')" ]
# JWT_SECRET must be at least 64 characters long
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_64_characters_long_for_security
BETTER_AUTH_SECRET=your_super_secret_better_auth_key
BETTER_AUTH_URL=http://localhost:5000

# --- Logging & Cache (Optional) ---
LOG_LEVEL=debug
MORGAN_FORMAT=dev
CACHE_ENABLED=false
CACHE_MODE=minimal

# --- Rate Limiting (Optional) ---
# RATE_LIMIT_AUTH_MAX=50
# RATE_LIMIT_AUTH_WINDOW_SECONDS=900

# --- Twilio (SMS & Notifications) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
