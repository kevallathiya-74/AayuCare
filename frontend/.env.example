# Frontend environment template (Expo / EAS)
# Copy to .env for local dev and set EAS project secrets for production builds.

# Explicit runtime mode used by APP_CONFIG (optional locally, recommended for builds)
EXPO_PUBLIC_NODE_ENV=development

# Backend API URLs
# Local development API (device/emulator can still auto-detect host IP if this is omitted)
EXPO_PUBLIC_API_BASE_URL_DEV=http://localhost:5000/api

# Production backend API
EXPO_PUBLIC_API_BASE_URL_PROD=https://your-production-api.example.com/api

# Optional explicit override for all modes
# EXPO_PUBLIC_API_BASE_URL=https://override-api.example.com/api

# Diagnostics and logging flags
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_VERBOSE_LOGGING=true
