{
  "expo": {
    "name": "AayuCare",
    "slug": "aayucare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "aayucare",
    "splash": {
      "image": "./assets/icons/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00ACC1"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aayucare.app",
      "buildNumber": "1",
      "icon": "./assets/icons/ios-icon.png",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#00ACC1"
      },
      "package": "com.aayucare.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "permissions": ["INTERNET", "CAMERA", "READ_MEDIA_IMAGES"]
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "sentryDSN": null,
      "EXPO_PUBLIC_NODE_ENV": null,
      "EXPO_PUBLIC_API_BASE_URL": null,
      "EXPO_PUBLIC_API_BASE_URL_DEV": null,
      "EXPO_PUBLIC_API_BASE_URL_PROD": null,
      "PRODUCTION_API_URL": null,
      "DEBUG_MODE": null,
      "VERBOSE_LOGGING": null,
      "eas": {
        "projectId": "31972ca4-e87a-4c14-862f-330973332013"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/app-icon.png",
          "color": "#00ACC1"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AayuCare to access your camera to take medical record photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AayuCare to access your photos to upload medical documents."
        }
      ]
    ]
  }
}
